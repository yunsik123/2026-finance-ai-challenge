PORT=8787
APP_SECRET=replace-with-a-long-random-string
# 서강대 SG-LLM(Mindlogic Gateway) 생성형 AI 설정
AI_API_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/chat/completions/
AI_API_KEY=
AI_MODEL=gpt-5.6-terra
# 이미지 입력을 지원하는 모델. 비어 있으면 AI_MODEL을 사용합니다.
AI_OCR_MODEL=

# 운영 DB 전환 시에만 사용합니다. service_role 키는 브라우저 VITE_* 변수에 넣지 마세요.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 기존 MOA/OpenAI 설정과도 호환됩니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MOA_CHAT_MODEL=gpt-4o-mini
MOA_OCR_MODEL=gpt-4o-mini
