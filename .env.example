PORT=8787
APP_SECRET=replace-with-a-long-random-string

# ── 생성형 AI: Google Vertex AI (Gemini) ─────────────────────────────
# API 키를 쓰지 않는다. 자격증명은 아래 순서로 자동 탐색된다.
#   ① Cloud Run·GCE 메타데이터 서버 (배포본 — 키 파일 없음)
#   ② GOOGLE_APPLICATION_CREDENTIALS 서비스 계정 키 파일
#   ③ gcloud auth application-default login 으로 만든 로컬 ADC
# 로컬 준비: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
# 리전 엔드포인트는 모델에 따라 404 가 난다. 기본 global 을 권장한다.
VERTEX_LOCATION=global
VERTEX_CHAT_MODEL=gemini-3-flash-preview
VERTEX_OCR_MODEL=gemini-3-flash-preview

# ── 원장 저장소 ──────────────────────────────────────────────────────
#   postgres  Cloud SQL PostgreSQL (운영 기본값)
#   file      data/db.json (로컬 개발·테스트)
# 적용: npm run db:check → npm run db:migrate
STATE_STORE=postgres
STATE_ROW_ID=meoktu
# Cloud SQL 연결. 로컬은 TCP, Cloud Run 은 유닉스 소켓을 쓴다.
#   로컬  postgresql://meoktu:<암호>@<공인IP>:5432/meoktu?sslmode=require
#   배포  INSTANCE_CONNECTION_NAME 만 주면 /cloudsql 소켓으로 붙는다
DATABASE_URL=
INSTANCE_CONNECTION_NAME=
DB_USER=meoktu
DB_PASSWORD=
DB_NAME=meoktu

# 인스턴스당 DB 연결 수. 이 값 × Cloud Run 최대 인스턴스 수가 총 연결 수다.
# Cloud SQL db-custom-2-7680 의 max_connections 는 400 이라 5 × 40대 = 200 으로 절반만 쓴다.
DB_POOL_MAX=5

# ── 지식그래프: Neo4j ────────────────────────────────────────────────
# 비워두면 서버 내장 그래프로 동작한다(기능은 유지되고 순회 깊이만 얕아진다).
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── 요청 한도 ────────────────────────────────────────────────────────
# 전부 선택이며 아래는 코드 기본값이다. 서비스 중에 한도 때문에 막히면
# 재배포 없이 늘릴 수 있도록 환경변수로 뺐다.
#   gcloud run services update meoktu --region=asia-northeast3 \
#     --update-env-vars=LIMIT_AI_CHAT=500
#
# 0 이하를 주면 그 한도를 끈다. 다만 생성형 한도(OCR·AI_CHAT·OWNER_REPORT·
# ANOMALY·INSIGHT)를 끄면 반복 호출이 그대로 Vertex AI 요금이 되므로,
# 끄기보다 넉넉히 올리는 편을 권한다.
#
# 도배 방지 (분당)
LIMIT_SIGNUP=60
LIMIT_COUPON_LIST=120
LIMIT_SWAP=120
LIMIT_OFFER=120
LIMIT_VERIFY=300
# 비용 방어 — 생성형 (분당)
LIMIT_OCR=60
LIMIT_AI_CHAT=120
# 비용 방어 — 생성형 분석 (시간당). 화면 새로고침마다 부르는 자리라 넉넉해야 한다.
LIMIT_OWNER_REPORT=200
LIMIT_ANOMALY=200
LIMIT_INSIGHT=300
# 업로드 이미지 상한(MB). 본문 크기 상한은 이 값의 1.4배로 자동 계산된다.
LIMIT_UPLOAD_MB=12
