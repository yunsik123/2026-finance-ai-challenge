PORT=8787
APP_SECRET=replace-with-a-long-random-string

# OpenAI 생성형 AI (GPT-4o-mini 등) 설정
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
# 이미지 영수증/증빙 OCR 판독 모델 (기본값: gpt-4o-mini)
OPENAI_OCR_MODEL=gpt-4o-mini

# 원장 저장소. service_role 키는 브라우저 VITE_* 변수에 넣지 마세요.
#   tables   meoktu 스키마의 정규화 테이블 24개 (운영 구조, 배포 기본값)
#   supabase app_state.data JSONB 단일 원장 (이전 구조, 호환용)
#   file     data/db.json  (로컬 개발·테스트)
# 적용: npm run db:check → npm run db:migrate
STATE_STORE=tables
STATE_ROW_ID=meoktu
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
